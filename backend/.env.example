# Copy this file to .env and fill in what you need; npm start reads it.
NVIDIA_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# WEAVE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Local MongoDB / MongoDB Compass:
MONGODB_URI=mongodb://127.0.0.1:27017/weave
MONGODB_DB_NAME=weave
# Original MongoDB Atlas template:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Optional: base64-encoded 32-byte key for AES-256-GCM application-level profile encryption.
# WEAVE_PROFILE_ENCRYPTION_KEY=
# Optional: Google OAuth 2.0 (for direct Google Calendar, Google Tasks & Google Keep API sync)
# Enable APIs in GCP: Google Calendar API, Google Tasks API, Google Keep API
# Add these redirect URIs in Google Cloud Console → OAuth client → Authorized redirect URIs:
#   http://127.0.0.1:4321/api/oauth/google/callback        (Calendar + Tasks)
#   http://127.0.0.1:4321/api/oauth/google/keep/callback   (Google Keep Notes)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4321/api/oauth/google/callback

# WEAVE_MODE=offline
# WEAVE_TODAY=2026-11-26
