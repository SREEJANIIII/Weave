# Copy this file to .env and fill in what you need; npm start reads it.
# API keys stay in this backend file and are never sent to the browser.
NVIDIA_API_KEY=
# Model used by the conversational planner.
NVIDIA_MODEL=openai/gpt-oss-20b
# Model used to read document images. Must support image input; Weave verifies this
# before sending any image (via catalog metadata or a small probe request).
# NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Raise this if a reasoning model spends its whole token budget before answering.
# NVIDIA_VISION_MAX_TOKENS=8192

# Local MongoDB (or a mongodb+srv:// Atlas URI).
MONGODB_URI=mongodb://127.0.0.1:27017/weave
MONGODB_DB_NAME=weave

# Appliances & Bills
# Reminder windows in days before a deadline (comma separated, descending).
# APPLIANCE_REMINDER_WINDOWS=30,14,7
# How many months of recurring EMI occurrences to materialise.
# APPLIANCE_EMI_MONTHS_AHEAD=6
# Original uploads are stored privately here; the browser only ever sees a document id.
# WEAVE_UPLOAD_DIR=./uploads/appliances
# Maximum upload size in bytes (default 15 MB).
# WEAVE_MAX_UPLOAD_BYTES=15728640
# Local OCR language and optional directory containing traineddata files.
# WEAVE_OCR_LANG=eng
# WEAVE_TESSERACT_LANG_PATH=./data/ocr

# Optional: base64-encoded 32-byte key for AES-256-GCM application-level profile encryption.
# WEAVE_PROFILE_ENCRYPTION_KEY=
# Optional: Google OAuth 2.0 (for direct Google Calendar, Google Tasks & Google Keep API sync)
# Enable APIs in GCP: Google Calendar API, Google Tasks API, Google Keep API
# Add these redirect URIs in Google Cloud Console → OAuth client → Authorized redirect URIs:
#   http://127.0.0.1:4321/api/oauth/google/callback        (Calendar + Tasks)
#   http://127.0.0.1:4321/api/oauth/google/keep/callback   (Google Keep Notes)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4321/api/oauth/google/callback

# Required: base64-encoded 32-byte key for AES-256-GCM application-level profile encryption.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEAVE_PROFILE_ENCRYPTION_KEY=
# WEAVE_MODE=offline
# WEAVE_TODAY=2026-11-26
