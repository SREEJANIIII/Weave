# Copy this file to .env and fill in what you need; npm start reads it.
ANTHROPIC_API_KEY=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=weave
# Optional: base64-encoded 32-byte key for AES-256-GCM application-level profile encryption.
# WEAVE_PROFILE_ENCRYPTION_KEY=
# WEAVE_MODE=offline
# WEAVE_MODEL=claude-opus-5-5
# WEAVE_EFFORT=medium
# WEAVE_TODAY=2026-11-26
